# Supabase project credentials
# Find these in your Supabase project: Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only service role key (NEVER expose to the client/browser).
# Used for privileged server-side operations (e.g. future admin scripts).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL, used to build absolute links (e.g. the kiosk QR check-in URL).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secret used to HMAC-sign QR attendance tokens (src/lib/qr/token.ts).
# Falls back to SUPABASE_SERVICE_ROLE_KEY (with a console warning) if unset,
# but set a dedicated value in production.
QR_TOKEN_SECRET=replace-with-a-long-random-string

# Google OAuth (configured in Supabase Auth providers + Google Cloud Console).
# These are typically NOT needed directly by the Next.js app (Supabase handles
# the OAuth exchange), but are listed here in case you wire up a custom flow.
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret

# Anthropic Claude API key (REQUIRED for Module 12 - AI Teacher Assistant).
# Used server-side only by src/lib/ai/client.ts to call the real Claude API
# (chat assistant, document/report writing, lesson assistant, knowledge
# base Q&A, etc.). Get a key from https://console.anthropic.com/
# Without this set, all AI features gracefully show "AI ไม่พร้อมใช้งาน"
# (AI unavailable) in the UI instead of crashing - they do NOT throw.
# Only Claude/Anthropic is wired - GPT/Gemini/Ollama multi-model support
# is explicitly out of scope for this module.
ANTHROPIC_API_KEY=
