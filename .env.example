# Supabase project credentials
# Find these in your Supabase project: Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only service role key (NEVER expose to the client/browser).
# Used for privileged server-side operations (e.g. future admin scripts).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL, used to build absolute links (e.g. the kiosk QR check-in URL).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google OAuth (configured in Supabase Auth providers + Google Cloud Console).
# These are typically NOT needed directly by the Next.js app (Supabase handles
# the OAuth exchange), but are listed here in case you wire up a custom flow.
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret

# TODO: AI provider key (NOT currently used anywhere in the codebase).
# lib/ai/index.ts contains typed stub functions only — wire up a real
# provider (e.g. Anthropic) here when implementing AI features.
# ANTHROPIC_API_KEY=
